{
    "character_name": "今汐",
    "moments": [
        {
            "id": "m1",
            "content": "从边庭出来站了会儿。\n风不错，比屋里那股墨味好闻。\n回去还得看三摞文书，先让我在这儿多待五分钟。",
            "images": ["files/01.jpg"],
            "likes": ["漂泊者", "长离", "卡提西娅", "守岸人"],
            "comments": [
                { "sender": "长离", "content": "五分钟。我看着表。" },
                { "sender": "今汐", "content": "……老师说五分钟，那就五分钟。", "reply_to": "长离" },
                { "sender": "漂泊者", "content": "今天风确实好。" },
                { "sender": "秧秧·玄翎", "content": "这样的风，走着舒服。" }
            ],
            "created_at": "2026-09-19T17:20:00.000"
        },
        {
            "id": "m2",
            "content": "跟残象周旋了半宿。\n刀还握得住，就是手腕有点抖。\n回去睡一觉就好，别声张。",
            "images": ["files/02.jpg"],
            "likes": ["漂泊者", "长离", "忌炎", "折枝"],
            "comments": [
                { "sender": "漂泊者", "content": "刚那一手，稳。" },
                { "sender": "今汐", "content": "还差得远。再来。", "reply_to": "漂泊者" },
                { "sender": "忌炎", "content": "令尹亲自下场，少见。" },
                { "sender": "长离", "content": "别练太晚，明天还有会。" }
            ],
            "created_at": "2026-09-15T21:40:00.000"
        },
        {
            "id": "m3",
            "content": "今晚月亮好，灯笼也挂上了。\n有片花落在肩上，顺手接了。\n带回去夹书里。",
            "images": ["files/03.jpg"],
            "likes": ["漂泊者", "长离", "秧秧·玄翎", "白芷"],
            "comments": [
                { "sender": "漂泊者", "content": "留吧，一片花而已。" },
                { "sender": "今汐", "content": "那就留着。你也留一片？", "reply_to": "漂泊者" },
                { "sender": "秧秧·玄翎", "content": "今州的花期总是很短。" }
            ],
            "created_at": "2026-09-08T20:10:00.000"
        },
        {
            "id": "m4",
            "content": "灯会上挑了盏莲花灯。\n掌柜的说许愿灵，我说那我替今州许一个——他就不肯收钱了。\n最后还是收了。",
            "images": ["files/04.jpg"],
            "likes": ["漂泊者", "长离", "卡提西娅", "守岸人", "折枝"],
            "comments": [
                { "sender": "漂泊者", "content": "替今州许的什么，说来听听。" },
                { "sender": "今汐", "content": "不告诉你。今州的规矩，说出来就不灵。", "reply_to": "漂泊者" },
                { "sender": "长离", "content": "就你嘴严。" },
                { "sender": "卡提西娅", "content": "灯很漂亮。" }
            ],
            "created_at": "2026-08-30T19:00:00.000"
        }
    ]
}